{
	"extends": ["@commitlint/config-conventional"],
	"rules": {
		"body-max-line-length": [2, "always", 100],
		"footer-max-line-length": [2, "always", 100],
		"type-enum": [
			2,
			"always",
			[
				"feat",
				"fix",
				"docs",
				"style",
				"refactor",
				"perf",
				"test",
				"build",
				"ci",
				"chore",
				"revert"
			]
		],
		"scope-enum": [
			2,
			"always",
			[
				"extension",
				"sounds",
				"scripts",
				"ci",
				"deps",
				"docs",
				"release",
				"config"
			]
		]
	}
}
